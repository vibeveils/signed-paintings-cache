{
	"schemaVersion": 1,
	"id": "signed_paintings_cache",
	"version": "${version}",
	"name": "Signed Paintings Cache",
	"description": "Companion for Signed Paintings: keeps painting images cached on disk between sessions, cuts repeat web requests, and adds quality, LOD and memory options.",
	"authors": ["codedcells"],
	"license": "LGPL-3.0",
	"environment": "client",
	"entrypoints": {
		"client": ["com.signedpaintingscache.PaintingsCache"],
		"modmenu": ["com.signedpaintingscache.compat.ModMenuIntegration"]
	},
	"mixins": ["signed_paintings_cache.mixins.json"],
	"depends": {
		"fabricloader": ">=0.18.5",
		"fabric-api": "*",
		"minecraft": ">=26.3",
		"java": ">=25",
		"signed_paintings": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
